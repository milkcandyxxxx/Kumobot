package ping

import (
	"github.com/milkcandyxxxx/Kumobot/bot"
	"github.com/milkcandyxxxx/Kumobot/bot/rule"
)

func init() {
	bot.OnPlugin("ping", "无", "milk", "无", "2", "false")
	bot.OnMessage(func(ctx *bot.Ctx) {
		ctx.ON11.Send("pong")
	}, rule.OnCommand("ping"))
}
